{
  "version": 2,
  "builds": [
    {
      "src": "housedata/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/static/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/static/js/sw.js"
    },
    {
      "src": "/(.*)",
      "dest": "housedata/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "housedata.settings"
  }
}
