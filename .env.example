# Official Divar Kenar Open API Key (x-api-key header)
DIVAR_API_KEY=

# Production Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@db:5432/housedata

# Celery Broker and Cache (Redis)
REDIS_URL=redis://redis:6379/0

# Django Security
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=*

# Divar Ingestion Tuning
MOCK_DIVAR_API=False
DIVAR_REQUEST_INTERVAL_SEC=0.5
DIVAR_DAILY_REQUEST_LIMIT=5000
